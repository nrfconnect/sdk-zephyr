# Enable MPU
CONFIG_ARM_MPU=y
CONFIG_NULL_POINTER_EXCEPTION_DETECTION_NONE=y

# Enable TrustZone-M
CONFIG_ARM_TRUSTZONE_M=y

# This board target implies building Non-Secure firmware, booted by IronSide TE
CONFIG_TRUSTED_EXECUTION_NONSECURE=y

# Take the application slot from devicetree
CONFIG_USE_DT_CODE_PARTITION=y

# Enable UART driver
CONFIG_SERIAL=y

# Enable console
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y

# Enable GPIO
CONFIG_GPIO=y

# Don't enable the cache in the non-secure image as it is a
# secure-only peripheral on nRF54L devices
CONFIG_CACHE_MANAGEMENT=n
CONFIG_EXTERNAL_CACHE=n

# Start SYSCOUNTER on driver init
CONFIG_NRF_GRTC_START_SYSCOUNTER=y

# OSCILLATORS shares its security attribution with REGULATORS rather than with
# CLOCK, so it stays secure and IronSide TE sets the PLL frequency before boot.
# Without this nrfx writes OSCILLATORS.PLL.FREQ in SystemInit() and bus-faults.
CONFIG_NRF_SKIP_CLOCK_CONFIG=y
