if SOC_NRF54L05_CPUFLPR || SOC_NRF54L10_CPUFLPR || SOC_NRF54L15_CPUFLPR || \
	SOC_NRF54LM20A_CPUFLPR || SOC_NRF54LM20B_CPUFLPR || SOC_NRF54LV10A_CPUFLPR

config HAS_NORDIC_VPR_LAUNCHER_IMAGE
	default y

endif

config IRONSIDE_TE
	bool
	help
	  IronSide TE provides the roots of trust and a set of secure services.
	  It replaces MCUboot: the application is a non-secure image signed with
	  the IronSide Integration Kit tooling and booted by the IronSide TE UROT.

if IRONSIDE_TE

config IRONSIDE_TE_KEYSET
	string "Key source holding the application signing key"
	default "keyring:dev"
	help
	  Passed as --keyset to the IronSide Integration Kit tools:
	  keyring:<keyset> or dir:<path>. The keyset must already exist,
	  created with ironsdk/scripts/iron_keychain.py, and the device must
	  be provisioned with its public half, or it rejects the signed image.

endif # IRONSIDE_TE

# IronSide TE is the bootloader, so MCUboot must not be built alongside it.
configdefault SUPPORT_BOOTLOADER_MCUBOOT_ZEPHYR
	default n if IRONSIDE_TE
