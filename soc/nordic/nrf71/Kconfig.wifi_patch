# Declared here because SoC code references it. Defaults and menu entry are
# supplied by the nrf71_wifi module in nrfxlib.
config WIFI_NRF71_PATCH
	bool

if WIFI_NRF71_PATCH

config WIFI_NRF71_PATCH_LMAC_ORIGIN
	hex "LMAC ROM patch MRAM origin" if WIFI_NRF71_PATCH_OVERRIDE_ORIGINS
	hex
	help
	  Fixed MRAM address of the LMAC ROM patch.

config WIFI_NRF71_PATCH_UMAC_ORIGIN
	hex "UMAC ROM patch MRAM origin" if WIFI_NRF71_PATCH_OVERRIDE_ORIGINS
	hex
	help
	  Fixed MRAM address of the UMAC ROM patch.

config WIFI_NRF71_PATCH_LMAC_SIZE
	int "LMAC ROM patch size in bytes"
	help
	  Size of the LMAC ROM patch in bytes. Defaults are supplied by the
	  nrf71_wifi module for the selected patch variant.

config WIFI_NRF71_PATCH_UMAC_SIZE
	int "UMAC ROM patch size in bytes"
	help
	  Size of the UMAC ROM patch in bytes. Defaults are supplied by the
	  nrf71_wifi module for the selected patch variant.

endif # WIFI_NRF71_PATCH
